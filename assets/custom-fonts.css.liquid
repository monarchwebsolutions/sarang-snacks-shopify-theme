/* Google Fonts: Cause, Inter, Manrope, Nunito, Outfit, Pangolin, Playpen Sans, Shantell Sans, and Short Stack */
@import url('https://fonts.googleapis.com/css2?family=Cause&family=Inter:ital,wght@0,100..900;1,100..900&family=Manrope:wght@200..800&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Outfit:ital,wght@0,100..900;1,100..900&family=Pangolin&family=Playpen+Sans:wght@100..800&family=Shantell+Sans:ital,wght@0,300..800;1,300..800&family=Short+Stack&display=swap');

@font-face {
  font-family: 'Nicko';
  src: url("{{ 'nicko.woff2' | asset_url }}") format('woff2'),
       url("{{ 'nicko.woff' | asset_url }}") format('woff');
  font-style: normal;
  font-weight: 400;
  font-display: swap;
}

.font-nicko {
  font-family: 'Nicko', sans-serif;
}

.font-manrope {
  font-family: 'Manrope', sans-serif;
  font-weight: 600;
}
